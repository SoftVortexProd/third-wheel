# Copy to deploy\server-secrets.env (gitignored) and fill in what you use. One TW_NAME=value per line, no spaces around the equals sign.
# sync.ps1 sends these to the server when it deploys; the server keeps them, so you only need them the first time (or when they change).

# --- Sign in with Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#     Authorised redirect URI: https://YOUR-ADDRESS/auth/google/callback
TW_GOOGLE_CLIENT_ID=
TW_GOOGLE_CLIENT_SECRET=

# --- Sign in with Discord uses the same app as "Verify Discord" (TW_DISCORD_CLIENT_ID / TW_DISCORD_CLIENT_SECRET, set with sync.ps1 -DiscordClientId ...).
#     Also add this redirect in the Discord developer portal: https://YOUR-ADDRESS/auth/discord/callback


# --- Email (verification links + "forgot password"). Any SMTP account works: Brevo, Resend, Mailgun, SendGrid, or a Gmail address with an app password.
#     Without these, sign-up simply doesn't ask for an email and "Forgot password?" stays hidden. Use an address on a domain you own for TW_MAIL_FROM.
TW_SMTP_HOST=
TW_SMTP_PORT=587
TW_SMTP_USER=
TW_SMTP_PASS=
TW_SMTP_SECURITY=starttls
TW_MAIL_FROM="Third Wheel <no-reply@example.com>"
